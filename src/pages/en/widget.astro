---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/isa-calculator/" title="ISA or taxable account calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the ISA and savings tax calculator on your website" description="Add the ISA against taxable account calculator to your website for free: one iframe, tax on interest for 2026/27 and 2027/28, no sign-up, no cookies and no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the ISA and savings tax calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a credit union's members page, a money guidance charity, a pensioners' group newsletter or a personal finance blog: readers type their income and savings and see what the interest costs them in tax this year and from April 2027, against a cash ISA.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible, use it as it is and without warranty, and do not present it as advice from your organisation. When the rules change, for instance when the 2028/29 rates are set, the embedded calculator updates itself.</p>
    <p>Nothing your readers type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/isa-calculator/" title="ISA or taxable account calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
